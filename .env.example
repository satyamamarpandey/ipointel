APP_NAME=IPO Intelligence Terminal
APP_ENV=development
DATABASE_URL=sqlite:///./data/ipo.db
PUBLIC_BASE_URL=http://localhost:8000
SEC_USER_AGENT=IPOIntelligence/2.0 your-email@example.com
ADMIN_TOKEN=change-me-in-production
WORKER_INTERVAL_SECONDS=900
DATA_STALE_AFTER_MINUTES=60
ALLOW_SECONDARY_MARKET_DATA=true
# EMAIL_PROVIDER selects exactly one transport - no silent fallback between them:
#   mailpit    - local dev/CI SMTP catch-all (github.com/axllent/mailpit). No account, no key.
#   smtp       - any real SMTP server you already have credentials for.
#   freeresend - self-hosted Resend-compatible gateway (github.com/eibrahim/freeresend), typically backed by Amazon SES.
#   resend     - hosted Resend SaaS. Optional; only needs RESEND_API_KEY when selected.
ENABLE_EMAIL=false
EMAIL_PROVIDER=mailpit
EMAIL_FROM=IPO Intelligence <noreply@ipo.local>

# --- mailpit / smtp ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# --- freeresend (self-hosted, no hosted Resend account required) ---
# See docker-compose.email.yml for how to run FreeResend itself.
# FREERESEND_BASE_URL is FreeResend's own base URL INCLUDING its /api segment
# (matches FreeResend's documented RESEND_BASE_URL convention), e.g.:
#   FREERESEND_BASE_URL=https://mail.yourdomain.com/api
FREERESEND_BASE_URL=
FREERESEND_API_KEY=
# FreeResend itself talks to Amazon SES - these are FreeResend's/the deployment's credentials, not read by this app directly.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- resend (optional hosted provider - NOT required) ---
RESEND_API_KEY=
RESEND_FROM=IPO Intelligence <updates@example.com>
# Signing secret from the Resend webhook you create (Step 15/16). Never commit a real value.
RESEND_WEBHOOK_SECRET=

# Soft send-rate limits (any provider); Resend's free plan is 100/day, 3000/month, so these leave a safety margin below that.
EMAIL_DAILY_SOFT_LIMIT=90
EMAIL_MONTHLY_SOFT_LIMIT=2800
EMAIL_MAX_ATTEMPTS=5
OPENROUTER_API_KEY=
# If true, the app refuses to issue Invest/Listing recommendations unless confidence >= threshold.
STRICT_RELIABILITY=true
MIN_RECOMMENDATION_CONFIDENCE=70

# Optional licensed/owned JSON feed for GMP, peer medians, subscription splits, registrar/allotment links.
SECONDARY_ENRICHMENT_URL=
SECONDARY_ENRICHMENT_TOKEN=

# --- Clerk (optional identity provider - beta access is still governed locally, see app/services/auth.py) ---
# Create a free Clerk application at https://clerk.com (Hobby tier), then paste
# its keys here. Leave blank to keep using the existing local magic-link login
# at /login - nothing breaks without these.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret from the Clerk webhook endpoint (Dashboard > Webhooks), pointed at /webhooks/clerk. Never commit a real value.
CLERK_WEBHOOK_SECRET=

# --- Google Sheets waitlist mirror (optional - PostgreSQL/SQLite is always the source of truth) ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
# Full JSON key of a Google Cloud service account with Editor access to the sheet above, as a single-line string. Never commit a real value.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
